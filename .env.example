SANITY_PROJECT_ID=m7gc2yj5
SANITY_DATASET=production
SANITY_API_VERSION=2024-10-01
# Nur für private Datasets nötig. Vercel: als Environment Variable setzen.
SANITY_READ_TOKEN=

# --- E-Mail-Versand (Resend) --------------------------------------------
# Kontaktformulare senden via Resend. API-Key: resend.com → API Keys → Create
RESEND_API_KEY=
# Empfänger (Standard: siteSettings.email in Sanity)
CONTACT_EMAIL=info@autocenterseeland.ch
# Absender. Bis autocenterseeland.ch bei Resend verifiziert ist,
# muss "onboarding@resend.dev" genutzt werden. Danach z.B.:
# RESEND_FROM="Auto Center Seeland <no-reply@autocenterseeland.ch>"
RESEND_FROM="Auto Center Seeland <onboarding@resend.dev>"
