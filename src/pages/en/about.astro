---
import Base from '../../layouts/Base.astro';
import View from '../../components/views/AboutView.astro';
import { getAboutPageContent, getSite } from '../../data/content';

const lang = 'en' as const;
const site = await getSite();
const about = await getAboutPageContent(lang, site);
---
<Base title={`${about.title} — ${site.legalName}`} description={about.paragraphs[0] ?? about.lead}>
  <View lang={lang} />
</Base>
