---
import Base from '../../layouts/Base.astro';
import View from '../../components/views/HomeView.astro';
import { getHomeContent } from '../../data/content';

const lang = 'en' as const;
const home = await getHomeContent(lang);
---
<Base title={home.meta.title} description={home.meta.description}>
  <View lang={lang} />
</Base>
