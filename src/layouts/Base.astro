---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations, alternatePath } from '../i18n/utils';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** Absolute or root-relative image for social previews */
  image?: string;
}
const { title, description, image = '/og-image.png' } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const canonical = new URL(Astro.url.pathname, Astro.site);
const alt = new URL(alternatePath(Astro.url, lang), Astro.site);
const ogImage = new URL(image, Astro.site);

/* Structured data — helps Google show the dealership correctly. */
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AutoDealer',
  name: site.legalName,
  alternateName: site.shortName,
  url: Astro.site?.toString(),
  logo: new URL('/brand/acs-lockup-black.svg', Astro.site).toString(),
  image: ogImage.toString(),
  telephone: site.phone,
  email: site.email,
  foundingDate: String(site.founded),
  vatID: site.uid,
  areaServed: 'CH',
  currenciesAccepted: 'CHF',
  sameAs: [site.social.instagram].filter(Boolean),
  address: site.offices.map((o) => ({
    '@type': 'PostalAddress',
    streetAddress: o.street,
    postalCode: o.zip,
    addressLocality: o.city,
    addressCountry: 'CH',
  })),
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <meta name="theme-color" content="#0a0a0a" />

    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={lang === 'de' ? 'en' : 'de'} href={alt} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.legalName} />
    <meta property="og:locale" content={lang === 'de' ? 'de_CH' : 'en_GB'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
  </head>

  <body>
    <a href="#main" class="skip-link">{t('nav.skip')}</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <script>
      /* Scroll reveal — one IntersectionObserver for the whole page.
         Elements are revealed once and then unobserved. */
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');

      if (reduce) {
        items.forEach((el) => el.classList.add('is-visible'));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -12% 0px', threshold: 0.08 }
        );
        items.forEach((el) => io.observe(el));
      }
    </script>
  </body>
</html>
